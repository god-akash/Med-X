# ==========================================
# Machine Learning Model Binaries
# ==========================================
# Ignore large model weights generated during runtime/experiments
*.pt
*.pth
*.onnx
*.bin
*.h5
*.weights
*.ckpt

# Protect and keep tracked sample models in test-models/
!test-models/**/*.safetensors
!test-models/manifest.json

